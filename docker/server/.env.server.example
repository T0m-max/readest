# Generate .env.server.local with init-env.py; do not use these placeholders.
DOMAIN=readest.example.com
PUBLIC_URL=https://readest.example.com
READEST_IMAGE=readest-selfhost:server
# Same pinned Node.js manifest as the upstream Dockerfile, via a mirror.
NODE_IMAGE=dockerproxy.net/library/node:24-slim@sha256:24dc26ef1e3c3690f27ebc4136c9c186c3133b25563ae4d7f0692e4d1fe5db0e
POSTGRES_PASSWORD=GENERATE_ME
JWT_SECRET=GENERATE_ME
ANON_KEY=GENERATE_ME
SERVICE_ROLE_KEY=GENERATE_ME
MINIO_ROOT_USER=GENERATE_ME
MINIO_ROOT_PASSWORD=GENERATE_ME
S3_BUCKET_NAME=readest-files

# Closed registration. Use create-user.py to create confirmed personal accounts.
DISABLE_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_ADMIN_EMAIL=

# Per-user storage in bytes. Translation quota does not configure a provider.
STORAGE_FIXED_QUOTA=1073741824
TRANSLATION_FIXED_QUOTA=50000
FONT_BASE_URL=
